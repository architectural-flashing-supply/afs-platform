# Source machine data — the raw Thalmann DS2801 database files are the shop's
# actual job history (real customer/project names, per the privacy audit in
# scripts/import-machine-profiles.ts), not something to keep in git history.
# Required locally only when running `pnpm run import:machine-profiles`.
machine-data/

# Playwright — tests/e2e/.auth/user.json is a real logged-in session's
# storageState (cookies/localStorage) once auth.setup.ts actually runs
# against a live E2E_TEST_EMAIL/E2E_TEST_PASSWORD account; never commit it.
/tests/e2e/.auth/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

.vercel

AFS CREDENTIALS.txt
.env.local.backup

# PATHFINDER_DEBUG_CAPTURE=1 output — real outgoing PathfinderEdge POST
# bodies (real profile geometry), diagnostic-only, never committed. Plus the
# ad-hoc probe scripts that accumulate in here during a run.
#
# EXCEPT the generated State of the Build report (v2-06). It is the one thing
# in this folder that is a deliverable rather than a byproduct: it is produced
# by scripts/audit/state-of-the-build-report.mjs from the live repository, it
# is what gets handed to Reid, and a report nobody else can see is not a
# handoff. The .md is tracked alongside the .docx deliberately, so the contents
# can be diffed between runs without opening Word.
#
# Written as `diagnostics/*` plus a negation rather than `diagnostics/`,
# because git cannot re-include a file whose PARENT DIRECTORY is excluded —
# it never descends into an ignored directory to find the exception.
diagnostics/*
!diagnostics/STATE_OF_THE_BUILD_*.docx
!diagnostics/STATE_OF_THE_BUILD_*.md

# Raw shop-floor source footage for the homepage hero/shop-floor-loop
# videos (real, unedited phone footage of the Thalmann machine) and the
# review frames pulled from it — never committed, only the encoded
# public/videos/*.mp4 + *.webm outputs are.
public/videos/metal-fab-*.mp4
scripts/video-review/*.jpg

# Prospect list PII and local repro/debug scratch dirs — never committed.
EMAIL PROSPECT LISTS/
.repro-*/
supabase/.temp/

# 2026-09-19 revision pass verification screenshots (full-page checkpoint
# captures) — local evidence for that session, never committed.
scratch-verify/

# The pixel gate's baselines are RE-RENDERED from the committed prototype on
# every run (tests/visual/v7-pixel-gate.spec.ts). They are evidence, not an
# expectation that can drift — there is deliberately no "update baselines" mode
# — so committing them would only add a few megabytes of churn per run. The
# canonical truth is docs/design/command-center-v7/AFS_Command_Center_Prototype_v7.html,
# which IS committed.
tests/visual/v7-baselines/
