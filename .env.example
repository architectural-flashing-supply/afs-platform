# AFS — Architectural Flashing Supply | Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase (PostgreSQL + RLS + Auth + Realtime + Storage) ──
NEXT_PUBLIC_SUPABASE_URL=              # Project API URL from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Public anon key — safe for client bundle
SUPABASE_SERVICE_ROLE_KEY=             # Service role key — server-only, bypasses RLS, never expose to client

# ── Anthropic (AI takeoff, spec writer, chatbot, recommendations) ──
ANTHROPIC_API_KEY=                     # Server-only — never call Anthropic from the client

# ── Stripe (checkout payments) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Publishable key — safe for client bundle
STRIPE_SECRET_KEY=                     # Server-only
STRIPE_WEBHOOK_SECRET=                 # Used to verify app/api/webhooks/stripe signature

# ── Resend (transactional email) ──
RESEND_API_KEY=                        # Server-only
RESEND_FROM_EMAIL=                     # Verified sender address, e.g. orders@architecturalflashingsupply.com

# ── Twilio (SMS production/delivery alerts) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                    # E.164 format, e.g. +15551234567

# ── TaxJar (multi-state tax compliance) ──
TAXJAR_API_KEY=                        # Server-only

# ── Google Maps (delivery address autocomplete, tracking map, server geocoding) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=       # Restrict to Places/Maps JS API and this domain
GOOGLE_MAPS_API_KEY=                   # Server-only — Geocoding API, used by lib/utils/geocode.ts

# ── Metals API (commodity pricing feed for internal pricing engine) ──
METALS_API_KEY=                       # Server-only — required to activate the pricing engine

# ── PathfinderEdge (Thalmann DS2801 machine integration) — real, live
# integration as of 2026-08-18, see lib/integrations/pathfinder-edge.ts.
# Raw (unprefixed) API key in the Authorization header. Catalog 20115
# ("afs") is the only catalog the machine subscribes to — see
# app/api/admin/command-center/approve/route.ts's AFS_MACHINE_CATALOG_ID. ──
PATHFINDER_EDGE_API_KEY=              # Server-only
PATHFINDER_EDGE_BASE_URL=             # e.g. https://afs.pathfinderedge.com
PATHFINDER_EDGE_MACHINE_SERIAL=       # e.g. P0700707

# ── AFS Machine Bridge (afs-machine-bridge — separate standalone project,
# see its own README.md) — authenticates app/api/machine-bridge/* routes via
# Bearer token instead of Supabase auth, since the bridge is a service, not
# a logged-in user. Must match AFS_BRIDGE_SECRET in the bridge's own .env. ──
AFS_BRIDGE_SECRET=                    # Server-only — shared secret, generate with e.g. `openssl rand -hex 16`

# ── Google Business Profile (GBP photo posting — see lib/integrations/google-business.ts,
# stubbed like QuickBooks/PathfinderEdge above until real OAuth is configured) ──
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_ACCESS_TOKEN=          # Manual stand-in until /admin/settings/integrations does a real OAuth exchange — see lib/integrations/google-business.ts's header comment

# ── Bid Monitor (federal/state procurement bid discovery — see
# lib/bid-monitor/**, supabase/migrations/010_bid_monitor.sql) ──
SAM_GOV_API_KEY=                      # Free — register at api.data.gov with the AFS email. Falls back to the rate-limited DEMO_KEY if unset.
PLANHUB_API_KEY=                      # Free — register at planhub.com, then get the key from account settings. Not yet wired to a fetcher.
BID_MONITOR_ALERT_EMAIL=tricia@architecturalflashingsupply.com  # Primary "New Opportunities" alert recipient (lib/bid-monitor/alerts.ts) — steve@architecturalflashingsupply.com is always CC'd as a second, hardcoded recipient.

# ── Pickup Scheduling (see app/api/pickup/schedule, PICKUP_SCHEDULING_SCOPE.md) ──
PICKUP_ALERT_EMAIL=tricia@architecturalflashingsupply.com  # Notified when a customer schedules a pickup window. Falls back to this same address if unset.

# ── Cron / scheduled jobs ──
CRON_SECRET=                           # Shared secret to authenticate Vercel Cron requests to app/api routes

# ── App ──
NEXT_PUBLIC_APP_URL=                   # Public base URL, e.g. https://architecturalflashingsupply.com

# ── Quotes, invoices and the Approve link (Command Center V2, prompt v2-03) ──
# All three are OPTIONAL and all three have a safe default, so the quote ->
# approve -> invoice path works on a fresh deployment with none of them set.
QUOTE_APPROVE_SECRET=                  # Signs the single-use Approve link in the quote email. If unset, a
                                       # SEPARATE key is derived from SUPABASE_SERVICE_ROLE_KEY by HMAC with a
                                       # fixed label (lib/pricing/approve-token.ts) — the derived key cannot be
                                       # used as the service role, and the service role cannot be recovered from
                                       # it. Set this to rotate every outstanding link at once.
INVOICE_OFFICE_EMAIL=                  # Where every approved invoice is copied automatically. Defaults to
                                       # tricia@architecturalflashingsupply.com (lib/data/office.ts).
AFS_EMAIL_TEST_MODE=                   # Set to 1 for LOCAL DEVELOPMENT ONLY: every outbound quote/invoice email
                                       # is recorded in `outbound_emails` and NO provider call is made.
                                       # Deliberately NOT set in Vercel — test mode is normally decided per
                                       # message by the reserved `E2E-TEST-` job-name prefix, so a deployment-wide
                                       # flag can never be left switched on and silence real customer mail.

# ── Command Center v7 fixture mode (the whole-screen pixel gate) ──
# LOCAL DEVELOPMENT AND CI ONLY. Makes the Command Center render prototype v7's
# own sample data instead of live data, so tests/visual/v7-pixel-gate.spec.ts
# diffs the app against the committed prototype with IDENTICAL CONTENT on both
# sides — which is what makes the diff percentage mean "fidelity" rather than
# "the database looks different from the demo".
#
# It takes THREE locks to open, not one (lib/fixtures/mode.ts): this variable,
# NODE_ENV !== 'production', AND `?fixture=v7` on the request URL. A production
# build refuses even with this set, which is asserted by lib/fixtures/mode.test.ts.
# Deliberately NOT set in Vercel, for any environment.
CC_FIXTURE=                            # Set to 1 locally to allow `?fixture=v7`. Never set in Vercel.

# ── Order validator — the OPTIONAL advisory AI layer (SPEC_AI_ORDER_VALIDATOR.md) ──
#
# The DETERMINISTIC rule engine (lib/order-validator/) is always on and needs no
# configuration: dimension ranges come from product_profiles, the sheet
# dimensions from lib/pricing/quote-math.ts, and everything else from a typed
# limits table. It never calls a model.
#
# This flag adds a SECOND, purely ADVISORY pass that asks Claude whether a set of
# dimensions looks odd to an experienced fabricator. It is OFF by default and off
# in Vercel. Three things are true of it whether it is on or not, and all three
# are asserted in lib/order-validator/ai-advisor.test.ts:
#   - it can never block. A finding it returns is clamped to a warning or a note,
#     and the deterministic `blocked` flag is untouched. A model does not get a
#     veto over a fabricable order.
#   - it can never report a price. The prompt forbids it and the parser DROPS any
#     message that reads as money, because a prompt is not enforcement.
#   - it can never throw. A timeout, a rejection, a non-JSON body or an invented
#     field name all yield no advisories and one server log line.
#
# Needs ANTHROPIC_API_KEY above. The exact string `1` — not "true", not "yes" —
# so a typo cannot switch it on.
AFS_ORDER_VALIDATOR_AI=                # Set to 1 to add advisory AI warnings at Step 2 -> Next. Default off.
