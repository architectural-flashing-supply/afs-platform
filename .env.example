# AFS — Architectural Flashing Supply | Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase (PostgreSQL + RLS + Auth + Realtime + Storage) ──
NEXT_PUBLIC_SUPABASE_URL=              # Project API URL from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Public anon key — safe for client bundle
SUPABASE_SERVICE_ROLE_KEY=             # Service role key — server-only, bypasses RLS, never expose to client

# ── Anthropic (AI takeoff, spec writer, chatbot, recommendations) ──
ANTHROPIC_API_KEY=                     # Server-only — never call Anthropic from the client

# ── Stripe (checkout payments) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Publishable key — safe for client bundle
STRIPE_SECRET_KEY=                     # Server-only
STRIPE_WEBHOOK_SECRET=                 # Used to verify app/api/webhooks/stripe signature

# ── Resend (transactional email) ──
RESEND_API_KEY=                        # Server-only
RESEND_FROM_EMAIL=                     # Verified sender address, e.g. orders@architecturalflashingsupply.com

# ── Twilio (SMS production/delivery alerts) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                    # E.164 format, e.g. +15551234567

# ── TaxJar (multi-state tax compliance) ──
TAXJAR_API_KEY=                        # Server-only

# ── Google Maps (delivery address autocomplete, tracking map, server geocoding) ──
NEXT_PUBLIC_GOOGLE_MAPS_KEY=           # Restrict to Places/Maps JS API and this domain
GOOGLE_MAPS_API_KEY=                   # Server-only — Geocoding API, used by lib/utils/geocode.ts

# ── Metals API (commodity pricing feed for internal pricing engine) ──
METALS_API_KEY=                       # Server-only — required to activate the pricing engine

# ── PathfinderEdge (Thalmann DS2801 machine integration) — stubbed, see
# lib/integrations/pathfinder-edge.ts. No confirmed REST API was discoverable
# at the base URL below as of this build; these vars are wired but unused. ──
PATHFINDER_EDGE_API_KEY=              # Server-only
PATHFINDER_EDGE_BASE_URL=             # e.g. https://afs.pathfinderedge.com
PATHFINDER_EDGE_MACHINE_SERIAL=       # e.g. P0700707

# ── AFS Machine Bridge (afs-machine-bridge — separate standalone project,
# see its own README.md) — authenticates app/api/machine-bridge/* routes via
# Bearer token instead of Supabase auth, since the bridge is a service, not
# a logged-in user. Must match AFS_BRIDGE_SECRET in the bridge's own .env. ──
AFS_BRIDGE_SECRET=                    # Server-only — shared secret, generate with e.g. `openssl rand -hex 16`

# ── Google Business Profile (GBP photo posting — see lib/integrations/google-business.ts,
# stubbed like QuickBooks/PathfinderEdge above until real OAuth is configured) ──
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_LOCATION_ID=

# ── Cron / scheduled jobs ──
CRON_SECRET=                           # Shared secret to authenticate Vercel Cron requests to app/api routes

# ── App ──
NEXT_PUBLIC_APP_URL=                   # Public base URL, e.g. https://architecturalflashingsupply.com
